// Git hooks managed by hk (https://hk.jdx.dev).
amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"

default_branch = "rigel-release"

hooks {
    ["pre-push"] {
        steps {
            ["fork-release-contracts"] = new Step {
                glob = List(".github/workflows/**", ".github/scripts/**")
                check = "node .github/scripts/workflow-contract.test.mjs && node .github/scripts/release-tag.test.mjs"
            }
        }
    }
}
